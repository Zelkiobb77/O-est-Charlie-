/* ====================================================================
   OSTING SUITE — Thème « NEON NOIR »
   --------------------------------------------------------------------
   Palette
     fond profond      #0a0a0c      surfaces      #101016 / #14141c
     violet néon       #a970ff      bleu glace    #58c7ff
     doré              #f3c969      vert ONLINE   #36e07f
     texte             #e8e8f2      texte atténué #7a7a8c
     bordures sombres  #20202c
   ==================================================================== */

Screen {
    background: #0a0a0c;
    color: #e8e8f2;
    scrollbar-background: #101016;
    scrollbar-color: #2a2a3a;
    scrollbar-color-hover: #a970ff;
    scrollbar-color-active: #58c7ff;
    scrollbar-size-vertical: 1;
}

/* ====================================================================
   SPLASH SCREEN
   ==================================================================== */
SplashScreen {
    align: center middle;
    background: #0a0a0c;
}

#splash-box {
    width: 72;
    height: auto;
    padding: 2 4;
    align: center middle;
    border: round #a970ff;
    border-title-color: #58c7ff;
    background: #0c0c10;
}

#splash-logo {
    width: 1fr;
    height: auto;
    content-align: center middle;
    margin-bottom: 1;
}

#splash-tagline {
    width: 1fr;
    content-align: center middle;
    color: #7a7a8c;
    text-style: bold;
    margin-bottom: 1;
}

#splash-spacer {
    height: 1;
}

#loading-bar {
    width: 1fr;
    align-horizontal: center;
    margin-bottom: 1;
}
#loading-bar Bar > .bar--bar {
    color: #a970ff;
    background: #1a1a24;
}
#loading-bar Bar > .bar--complete {
    color: #36e07f;
}
#loading-bar PercentageStatus {
    color: #58c7ff;
    text-style: bold;
}

#loading-status {
    width: 1fr;
    content-align: center middle;
    color: #b8b8c8;
}

/* ====================================================================
   HEADER (TopBar)
   ==================================================================== */
#topbar {
    height: 3;
    padding: 1 2 0 2;
    background: #0c0c12;
    border-bottom: heavy #a970ff;
}

/* ====================================================================
   CORPS : sidebar + zone principale
   ==================================================================== */
#body {
    height: 1fr;
    padding: 1 1 0 1;
}

/* ---- Sidebar ---- */
#sidebar {
    width: 32;
    margin-right: 1;
    padding: 1 1;
    background: #0e0e14;
    border: round #2a2a3a;
    border-title-color: #a970ff;
    border-title-align: left;
}

#categories {
    height: 1fr;
    background: transparent;
}

/* ---- Zone principale ---- */
#main {
    width: 1fr;
    height: 1fr;
}

#tools {
    height: 30%;
    padding: 0 1;
    background: #0c0c12;
    border: round #2a2a3a;
    border-title-color: #58c7ff;
    border-title-align: left;
    margin-bottom: 1;
}

/* ====================================================================
   LISTES : hover + highlight très marqués
   ==================================================================== */
ListItem {
    padding: 0 1;
    color: #c8c8d4;
    background: transparent;
}

/* survol souris : réaction immédiate */
ListView > ListItem:hover {
    background: #17171f;
    color: #ffffff;
}

/* élément pointé par les flèches (liste non focus) */
ListView > ListItem.-highlight {
    background: #1c1430;
    color: #d8c8ff;
    text-style: bold;
}

/* élément sélectionné dans la liste ACTIVE : violet plein, très tranché */
ListView:focus > ListItem.-highlight {
    background: #a970ff;
    color: #0a0a0c;
    text-style: bold;
}

/* ====================================================================
   PANNEAU DÉTAIL / EXÉCUTION
   ==================================================================== */
#detail {
    height: 1fr;
    padding: 1 2;
    background: #0c0c12;
    border: round #2a2a3a;
    border-title-color: #f3c969;
    border-title-align: left;
}

#detail-head {
    height: auto;
    margin-bottom: 1;
}

/* ---- Ligne de contrôle : saisie + bouton ---- */
#controls {
    height: 3;
    margin-bottom: 1;
}
#tool-input {
    width: 1fr;
    height: 3;
    background: #08080c;
    color: #e8e8f2;
    border: tall #2a2a3a;
    padding: 0 1;
}
#tool-input:focus {
    border: tall #58c7ff;
    background: #0c0c14;
}
#tool-input > .input--placeholder {
    color: #4a4a5a;
}

/* ---- Bouton Exécuter ---- */
#run-btn {
    width: auto;
    min-width: 16;
    height: 3;
    margin-left: 1;
    background: #a970ff;
    color: #0a0a0c;
    text-style: bold;
    border: none;
}
#run-btn:hover {
    background: #58c7ff;
    color: #06121a;
}
#run-btn:focus {
    background: #c79bff;
    text-style: bold;
}

/* ---- Barre de progression (visible seulement pendant un job) ---- */
#tool-progress {
    height: 1;
    margin-bottom: 1;
    display: none;
}
#tool-progress Bar {
    width: 1fr;
}
#tool-progress Bar > .bar--bar {
    color: #a970ff;
    background: #1a1a24;
}
#tool-progress Bar > .bar--complete {
    color: #36e07f;
}
#tool-progress Bar > .bar--indeterminate {
    color: #58c7ff;
}
#tool-progress PercentageStatus {
    color: #58c7ff;
    text-style: bold;
}

/* ---- Live console (terminal interne) ---- */
#console {
    height: 1fr;
    padding: 0 1;
    background: #07070b;
    border: round #20202c;
    border-title-color: #58c7ff;
}

/* ====================================================================
   FOOTER
   ==================================================================== */
#statusfooter {
    height: 1;
    padding: 0 2;
    background: #0c0c12;
    color: #7a7a8c;
    border-top: heavy #2a2a3a;
}

/* ====================================================================
   API VAULT (modal)
   ==================================================================== */
SettingsScreen {
    align: center middle;
}

#settings-box {
    width: 74;
    height: auto;
    padding: 1 2;
    background: #0d0d13;
    border: round #a970ff;
}

#settings-title {
    text-style: bold;
    color: #a970ff;
}
#settings-sub {
    color: #7a7a8c;
    margin-bottom: 1;
}

.set-row {
    height: 3;
}
.set-label {
    width: 22;
    content-align: left middle;
    color: #c8c8d4;
}
.set-input {
    width: 1fr;
    background: #08080c;
    border: tall #2a2a3a;
}
.set-input:focus {
    border: tall #58c7ff;
}

#settings-actions {
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}
#settings-actions Button {
    margin-left: 2;
    height: 3;
    border: none;
}
#save-settings {
    background: #36e07f;
    color: #062012;
    text-style: bold;
}
#save-settings:hover {
    background: #5cf0a0;
}
#close-settings {
    background: #20202c;
    color: #c8c8d4;
}
#close-settings:hover {
    background: #2a2a3a;
}
